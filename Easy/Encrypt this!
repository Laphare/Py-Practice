def encrypt_this(text):
    result = []

    for word in text.split():
        if len(word) == 1:
            result.append(str(ord(word[0])))
        elif len(word) == 2:
            result.append(str(ord(word[0])) + word[1])
        else:
            result.append(
                str(ord(word[0])) + word[-1] + word[2:-1] + word[1]
            )

    return " ".join(result)
