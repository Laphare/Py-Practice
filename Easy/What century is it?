def what_century(year):
    yr = (int(year) - 1) // 100 + 1
    y = str(yr)
    
    if int(y) % 100 in (11, 12, 13):
        return str(y) + "th"
    if y[-1] == "1":
        return y+"st"
    elif y[-1] == "2":
        return y+"nd"
    elif y[-1] == "3":
        return y+"rd"
    else:
        return y+"th"
