def is_valid_walk(walk):
    #determine if walk is valid
    x = y = 0
    for step in walk:
        if step == "n":
            y += 1
        if step == "s":
            y -= 1
        if step == "w":
            x += 1
        if step == "e":
            x -= 1
    return len(walk) == 10 and (y == 0 and x == 0)
