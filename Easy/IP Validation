def is_valid_IP(strng):
    x = strng.split(".")
    if len(x) != 4:
        return False
    for i in range(len(x)):
        if not x[i].isdigit():
            return False
        elif len(x[i])>= 2 and x[i][0] == "0":
            return False
        elif not ( 0 <= int(x[i]) <= 255):
            return False
    return True
