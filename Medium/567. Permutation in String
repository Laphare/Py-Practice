class Solution:
    def checkInclusion(self, s1: str, s2: str) -> bool:
        n1,n2=len(s1),len(s2)
        count_1=[0]*26
        count_2=[0]*26

        for letters_1 in s1:
            count_1[ord(letters_1)-ord('a')] += 1
        for i in range(n2):
            count_2[ord(s2[i])-ord('a')] += 1
            if i >= n1:
                count_2[ord(s2[i-n1])-ord('a')] -= 1
            if i >= n1-1:
                if count_1 == count_2:
                    return True
        return False
