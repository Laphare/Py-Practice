class Solution:
    def longestConsecutive(self, nums: List[int]) -> int:
        consecutive_number = set(nums)
        longest_length=0
        for num in consecutive_number:
            if num-1 not in consecutive_number:
                current_length = 1
                current_num = num

                while current_num+1 in consecutive_number:
                    current_length +=1
                    current_num += 1

                longest_length= max(longest_length,current_length)
        return longest_length
