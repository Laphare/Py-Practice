class Solution:
    def compress(self, chars: list[str]) -> int:
        x=0
        y=0
        
        while x < len(chars):
            char = chars[x]
            count = 0 
            while x < len(chars) and chars[x] == char:
                x += 1
                count +=1
            chars[y] = char
            y+=1
            if count > 1:
                for c in str(count):
                    chars[y] = c
                    y += 1
        return y
